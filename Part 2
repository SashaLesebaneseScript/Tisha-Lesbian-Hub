local function TeleportToElevator()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local currentRoom = workspace:FindFirstChild("CurrentRoom")
    if not currentRoom then return end
    local elevators = currentRoom:FindFirstChild("Elevators")
    local elevator = elevators and elevators:FindFirstChild("Elevator")
    local spawnZones = elevator and elevator:FindFirstChild("SpawnZones")
    if spawnZones then
        local targetPart = spawnZones:FindFirstChildWhichIsA("BasePart", true)
        if targetPart then 
            char:PivotTo(targetPart.CFrame + Vector3.new(0, 3, 0)) 
        end
    end
end

CreateButton("Tp to elevator", nil, TeleportToElevator)

local function ClearHighlights(tbl) 
    for _, h in pairs(tbl) do 
        if h then h:Destroy() end 
    end
    table.clear(tbl) 
end

local function ClearDrawings(tbl) 
    for _, d in pairs(tbl) do 
        if type(d) == "table" then 
            for _, v in pairs(d) do 
                if v.Remove then v:Remove() end 
            end
        elseif d.Remove then 
            d:Remove() 
        end 
    end
    table.clear(tbl) 
end

local function ClearAll() 
    for _, t in pairs(Highlights) do ClearHighlights(t) end
    for _, t in pairs(Drawings) do ClearDrawings(t) end
end

local function CreateHighlight(target, fillColor, outlineColor)
    local hl = Instance.new("Highlight")
    hl.Adornee = target
    hl.FillColor = fillColor
    hl.OutlineColor = outlineColor or fillColor
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = workspace
    return hl
end

local function CreateText()
    local t = Drawing.new("Text")
    t.Center = true
    t.Outline = true
    t.OutlineColor = Color3.fromRGB(0, 0, 0)
    t.Visible = false
    return t
end
