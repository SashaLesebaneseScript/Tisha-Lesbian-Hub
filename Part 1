function FormatName(name)
    local formatted = string.gsub(name, "Monster", "")
    formatted = string.gsub(formatted, "(%u)", " %1")
    formatted = string.gsub(formatted, "^%s*(.-)%s*$", "%1")
    return formatted
end

function GetItemColor(name)
    local lowerName = string.lower(name)
    if string.find(lowerName, "bandage") or string.find(lowerName, "health") or string.find(lowerName, "ornament") or string.find(lowerName, "basket") or string.find(lowerName, "pumpkin") then
        return GetFluidRainbow()
    end
    for key, colorFn in pairs(ItemColors) do
        if string.find(lowerName, key) then
            if type(colorFn) == "function" then return colorFn() else return colorFn end
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

function GetTwistedColors(name)
    local lowerName = string.lower(name)
    local fill = Color3.fromRGB(255, 0, 0)
    local outline = Color3.fromRGB(255, 0, 0)
    if string.find(lowerName, "eclipse") or string.find(lowerName, "soulvester") or string.find(lowerName, "ribecca") then fill = Color3.fromRGB(255, 165, 0); outline = fill
    elseif string.find(lowerName, "cocoa") or string.find(lowerName, "flyte") or string.find(lowerName, "eggson") then fill = Color3.fromRGB(255, 105, 180); outline = fill
    elseif string.find(lowerName, "ruddie") or string.find(lowerName, "coal") or string.find(lowerName, "ginger") then fill = Color3.fromRGB(0, 255, 255); outline = fill
    elseif string.find(lowerName, "astro") or string.find(lowerName, "shelly") or string.find(lowerName, "vee") or string.find(lowerName, "pebble") or string.find(lowerName, "sprout") then fill = GetFluidRainbow(); outline = fill
    elseif string.find(lowerName, "gourdy") then fill = GetFluidRainbow(); outline = Color3.fromRGB(255, 165, 0)
    elseif string.find(lowerName, "bassie") then fill = GetFluidRainbow(); outline = Color3.fromRGB(255, 105, 180)
    elseif string.find(lowerName, "bobette") then fill = GetFluidRainbow(); outline = Color3.fromRGB(255, 0, 0)
    elseif string.find(lowerName, "dyle") or string.find(lowerName, "dandy") then fill = GetDarkRainbow(); outline = fill end
    return fill, outline
end

function GetGeneratorColor(gen)
    local stats = gen:FindFirstChild("Stats")
    local hasBrusha = gen:FindFirstChild("BrushaDebuffChamber", true) ~= nil
    local connieObj = stats and stats:FindFirstChild("Connie")
    local hasConnie = connieObj and connieObj:IsA("BoolValue") and connieObj.Value
    local cGray = Color3.fromRGB(128, 128, 128); local cViolet = Color3.fromRGB(128, 0, 128); local cCyan = Color3.fromRGB(0, 255, 255)
    local alpha = (math.sin(tick() * 4) + 1) / 2
    if hasBrusha and hasConnie then
        local t = (tick() % 3)
        if t < 1 then return cGray:Lerp(cCyan, t) elseif t < 2 then return cCyan:Lerp(cViolet, t - 1) else return cViolet:Lerp(cGray, t - 2) end
    elseif hasBrusha then return cGray:Lerp(cViolet, alpha) elseif hasConnie then return cGray:Lerp(cCyan, alpha) end
    return cGray
end

function GetClosest(targetFolderName, ignoreCompleted, findFurthest)
    local closest = nil
    local bestDist = findFurthest and -1 or math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local currentRoom = workspace:FindFirstChild("CurrentRoom") or workspace:FindFirstChild("GameRoom") or workspace
    for _, room in pairs(currentRoom:GetChildren()) do
        local folder = room:FindFirstChild(targetFolderName)
        if folder then
            for _, obj in pairs(folder:GetChildren()) do
                local part = obj:FindFirstChildWhichIsA("BasePart")
                local isCompleted = false
                if ignoreCompleted and obj:FindFirstChild("Stats") then
                    local completedVal = obj.Stats:FindFirstChild("Completed")
                    if completedVal and completedVal.Value == true then isCompleted = true end
                end
                if part and not isCompleted then
                    local d = (char.HumanoidRootPart.Position - part.Position).Magnitude
                    if (findFurthest and d > bestDist) or (not findFurthest and d < bestDist) then bestDist = d; closest = part end
                end
            end
        end
    end
    return closest
end

function TPToObject(part)
    pcall(function()
        if part and part.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

function InteractWithObject(part)
    pcall(function()
        if not part or not part.Parent then return end
        local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then prompt:InputHoldBegin(); task.wait(0.1); prompt:InputHoldEnd()
        else VIM:SendKeyEvent(true, "E", false, game); task.wait(0.1); VIM:SendKeyEvent(false, "E", false, game) end
    end)
end
