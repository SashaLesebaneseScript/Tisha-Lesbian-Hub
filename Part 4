task.spawn(function()
    while task.wait(0.25) do
        if Toggles.AutoFarm then
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then
                continue
            end

            local monster = GetClosest("Monsters", false, false)
            if monster and (char.HumanoidRootPart.Position - monster.Position).Magnitude < DangerDistance then
                local safeSpot = GetClosest("Generators", true, true) or GetClosest("Elevators", false, true)
                if safeSpot then
                    TPToObject(safeSpot)
                    task.wait(0.5)
                    continue
                end
            end

            local item = GetClosest("Items", false, false)
            if item and (char.HumanoidRootPart.Position - item.Position).Magnitude < PickupDistance then
                InteractWithObject(item)
                task.wait(0.1)
            end

            local gen = GetClosest("Generators", true, false)
            if gen then
                local dist = (char.HumanoidRootPart.Position - gen.Position).Magnitude
                if dist > 6 then
                    TPToObject(gen)
                else
                    if not (Toggles.AutoBar or Toggles.AutoCircle or Toggles.AutoTreadmill) then
                        InteractWithObject(gen)
                        task.wait(0.5)
                    end
                end
            else
                local elevator = GetClosest("Elevators", false, false)
                if elevator then
                    if (char.HumanoidRootPart.Position - elevator.Position).Magnitude > 5 then
                        TPToObject(elevator)
                        InteractWithObject(elevator)
                    end
                    task.wait(2)
                end
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    if Toggles.Noclip and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if Toggles.Speed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = WalkSpeed_Value
    end
end)

LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    task.wait(0.5)
    
    if Toggles.Speed and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = WalkSpeed_Value
    end
    
    if Toggles.Noclip then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end
end)
