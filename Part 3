RunService.RenderStepped:Connect(function()
    if Toggles.FullBright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.FogEnd = 100000
        Lighting.Brightness = 2
    elseif Toggles.AltFullBright then
        Lighting.Ambient = Color3.fromRGB(150, 150, 150)
        Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
        Lighting.Brightness = 1.5
        Lighting.ClockTime = 12
    else
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        Lighting.FogEnd = OriginalLighting.FogEnd
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.ClockTime = OriginalLighting.ClockTime
    end

    if Toggles.AutoElevator then
        local info = workspace:FindFirstChild("Info")
        local panic = info and info:FindFirstChild("Panic")
        if panic and panic.Value and tick() - lastAutoTp > 1 then 
            TeleportToElevator()
            lastAutoTp = tick() 
        end
    end

    local currentRoom = workspace:FindFirstChild("CurrentRoom")
    if currentRoom ~= LastRoom then 
        ClearAll()
        LastRoom = currentRoom 
    end

    if not Toggles.EspPlayers then ClearHighlights(Highlights.Players) end
    if not Toggles.Nametag and not Toggles.EspItems then ClearDrawings(Drawings.Players) end
    if not Toggles.EspTrinkets then ClearHighlights(Highlights.Trinkets); ClearDrawings(Drawings.Trinkets) end
    if not Toggles.EspItems then ClearHighlights(Highlights.Items) end
    if not Toggles.EspDescription then ClearDrawings(Drawings.Items) end
    if not Toggles.EspTwisteds then ClearHighlights(Highlights.Twisteds) end
    if not Toggles.EspNametagResearch then ClearDrawings(Drawings.Twisteds) end
    if not Toggles.EspDoors then ClearHighlights(Highlights.Doors); ClearDrawings(Drawings.Doors) end
    if not Toggles.EspGenerators then ClearHighlights(Highlights.Generators); ClearDrawings(Drawings.Generators) end

    if Toggles.EspPlayers or Toggles.Nametag or Toggles.EspItems then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local root = player.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                
                if Toggles.EspPlayers and not Highlights.Players[player] then 
                    Highlights.Players[player] = CreateHighlight(player.Character, Color3.fromRGB(0, 255, 255)) 
                end
                
                if not Drawings.Players[player] then Drawings.Players[player] = CreateText() end
                local draw = Drawings.Players[player]
                
                if onScreen and dist < 1000 then
                    if Toggles.Nametag then
                        draw.Text = player.Name
                        draw.Size = math.clamp(1000 / dist, 12, 18)
                        draw.Position = Vector2.new(pos.X, pos.Y - 30)
                        draw.Color = Color3.fromRGB(255, 255, 255)
                        draw.Visible = true
                    else 
                        draw.Visible = false 
                    end
                else 
                    draw.Visible = false 
                end
            else
                if Highlights.Players[player] then Highlights.Players[player]:Destroy(); Highlights.Players[player] = nil end
                if Drawings.Players[player] then Drawings.Players[player]:Remove(); Drawings.Players[player] = nil end
            end
        end
    end

    if Toggles.EspTrinkets then
        local inGamePlayers = workspace:FindFirstChild("InGamePlayers")
        if inGamePlayers then
            for _, pFolder in pairs(inGamePlayers:GetChildren()) do
                local trinketsFolder = pFolder:FindFirstChild("Trinkets")
                if trinketsFolder then
                    for _, trinket in pairs(trinketsFolder:GetChildren()) do
                        if trinket:IsA("Model") or trinket:IsA("BasePart") then
                            if not Highlights.Trinkets[trinket] then 
                                Highlights.Trinkets[trinket] = CreateHighlight(trinket, Color3.fromRGB(0, 255, 255)) 
                            end
                            
                            local part = trinket:IsA("BasePart") and trinket or trinket:FindFirstChildWhichIsA("BasePart")
                            if part and part.Parent then
                                local pos, onScreen = Camera:WorldToViewportPoint(part.Position + Vector3.new(0, part.Size.Y/2 + 1, 0))
                                if not Drawings.Trinkets[trinket] then Drawings.Trinkets[trinket] = CreateText() end
                                local draw = Drawings.Trinkets[trinket]
                                if onScreen then
                                    draw.Text = trinket.Name
                                    draw.Size = 14
                                    draw.Position = Vector2.new(pos.X, pos.Y)
                                    draw.Color = Color3.fromRGB(0, 255, 255)
                                    draw.Visible = true
                                else 
                                    draw.Visible = false 
                                end
                            end
                        end
                    end
                end
            end
        end
        for obj, hl in pairs(Highlights.Trinkets) do if not obj.Parent then hl:Destroy(); Highlights.Trinkets[obj] = nil end end
        for obj, draw in pairs(Drawings.Trinkets) do if not obj.Parent then draw:Remove(); Drawings.Trinkets[obj] = nil end end
    end

    if currentRoom and (Toggles.EspItems or Toggles.EspDescription) then
        local itemsFolder = currentRoom:FindFirstChild("Items", true)
        if itemsFolder then
            for _, item in pairs(itemsFolder:GetChildren()) do
                if item:IsA("Model") or item:IsA("BasePart") then
                    local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                    if part and part.Parent then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position + Vector3.new(0, part.Size.Y/2 + 1.5, 0))
                        local dist = (Camera.CFrame.Position - part.Position).Magnitude
                        local itemColor = GetItemColor(item.Name)
                        
                        if Toggles.EspItems and not Highlights.Items[item] then 
                            Highlights.Items[item] = CreateHighlight(item, itemColor)
                        elseif Toggles.EspItems and Highlights.Items[item] then 
                            Highlights.Items[item].FillColor = itemColor
                            Highlights.Items[item].OutlineColor = itemColor 
                        end

                        if Toggles.EspDescription then
                            if not Drawings.Items[item] then Drawings.Items[item] = CreateText() end
                            local draw = Drawings.Items[item]
                            if onScreen and dist < 800 then
                                local nameStr = item.Name
                                local finalText = string.gsub(nameStr, "(%u)", " %1")
                                if string.find(string.lower(nameStr), "research capsule") then
                                    local prompt = item:FindFirstChild("Prompt")
                                    local monsterObj = prompt and prompt:FindFirstChild("Monster")
                                    local mName = monsterObj and monsterObj.Value or "Unknown"
                                    finalText = "Twisted: " .. FormatName(mName)
                                end
                                draw.Text = finalText
                                draw.Color = itemColor
                                draw.Size = math.clamp(1000 / dist, 12, 18)
                                draw.Position = Vector2.new(pos.X, pos.Y)
                                draw.Visible = true
                            else 
                                draw.Visible = false 
                            end
                        end
                    end
                end
            end
            for obj, hl in pairs(Highlights.Items) do if not obj.Parent then hl:Destroy(); Highlights.Items[obj] = nil end end
            for obj, draw in pairs(Drawings.Items) do if not obj.Parent then draw:Remove(); Drawings.Items[obj] = nil end end
        end
    end

    if currentRoom and (Toggles.EspTwisteds or Toggles.EspNametagResearch) then
        local monstersFolder = currentRoom:FindFirstChild("Monsters", true)
        if monstersFolder then
            for _, monster in pairs(monstersFolder:GetChildren()) do
                if monster:IsA("Model") then
                    local root = monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChildWhichIsA("BasePart")
                    if root and root.Parent then
                        local pos, onScreen = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, root.Size.Y/2 + 1.5, 0))
                        local dist = (Camera.CFrame.Position - root.Position).Magnitude
                        local fill, outline = GetTwistedColors(monster.Name)
                        
                        if Toggles.EspTwisteds then
                            if not Highlights.Twisteds[monster] then 
                                Highlights.Twisteds[monster] = CreateHighlight(monster, fill, outline)
                            else 
                                Highlights.Twisteds[monster].FillColor = fill
                                Highlights.Twisteds[monster].OutlineColor = outline 
                            end
                        end

                        if Toggles.EspNametagResearch then
                            if not Drawings.Twisteds[monster] then Drawings.Twisteds[monster] = CreateText() end
                            local draw = Drawings.Twisteds[monster]
                            if onScreen and dist < 1000 then
                                local researchAmt = 0
                                local playerData = workspace:FindFirstChild("PlayerData")
                                if playerData then
                                    local myData = playerData:FindFirstChild(tostring(LocalPlayer.UserId)) or playerData:FindFirstChild(LocalPlayer.Name)
                                    if myData and myData:FindFirstChild("Research") then
                                        local mName = monster.Name
                                        local rObj = myData.Research:FindFirstChild(mName) or myData.Research:FindFirstChild(string.gsub(mName, "Monster", ""))
                                        if rObj and rObj:IsA("ValueBase") then researchAmt = rObj.Value end
                                    end
                                end
                                local lowerName = string.lower(monster.Name)
                                local isLethal = string.find(lowerName, "dandy") or string.find(lowerName, "dyle")
                                local lethalText = isLethal and "LETHAL\n" or ""
                                draw.Text = lethalText .. FormatName(monster.Name) .. "\nResearch: " .. tostring(math.floor(researchAmt))
                                draw.Size = math.clamp(1000 / dist, 12, 20)
                                draw.Position = Vector2.new(pos.X, pos.Y)
                                draw.Color = fill
                                draw.Visible = true
                            else 
                                draw.Visible = false 
                            end
                        end
                    end
                end
            end
            for obj, hl in pairs(Highlights.Twisteds) do if not obj.Parent then hl:Destroy(); Highlights.Twisteds[obj] = nil end end
            for obj, draw in pairs(Drawings.Twisteds) do if not obj.Parent then draw:Remove(); Drawings.Twisteds[obj] = nil end end
        end
    end

    if currentRoom and Toggles.EspDoors then
        local doorsFolder = currentRoom:FindFirstChild("TrickOrTreatDoors", true)
        if doorsFolder then
            for _, door in pairs(doorsFolder:GetChildren()) do
                if door:IsA("Model") or door:IsA("BasePart") then
                    local part = door:IsA("BasePart") and door or door:FindFirstChildWhichIsA("BasePart")
                    if part and part.Parent then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position + Vector3.new(0, part.Size.Y/2 + 1, 0))
                        local dist = (Camera.CFrame.Position - part.Position).Magnitude
                        if not Highlights.Doors[door] then Highlights.Doors[door] = CreateHighlight(door, Color3.fromRGB(255, 165, 0)) end
                        if not Drawings.Doors[door] then Drawings.Doors[door] = CreateText() end
                        local draw = Drawings.Doors[door]
                        if onScreen and dist < 1000 then
                            draw.Text = "Halloween door"
                            draw.Size = math.clamp(1000 / dist, 12, 20)
                            draw.Position = Vector2.new(pos.X, pos.Y)
                            draw.Color = Color3.fromRGB(255, 165, 0)
                            draw.Visible = true
                        else 
                            draw.Visible = false 
                        end
                    end
                end
            end
            for obj, hl in pairs(Highlights.Doors) do if not obj.Parent then hl:Destroy(); Highlights.Doors[obj] = nil end end
            for obj, draw in pairs(Drawings.Doors) do if not obj.Parent then draw:Remove(); Drawings.Doors[obj] = nil end end
        end
    end

    if currentRoom and Toggles.EspGenerators then
        local genFolder = currentRoom:FindFirstChild("Generators", true)
        if genFolder then
            for _, gen in pairs(genFolder:GetChildren()) do
                if gen:IsA("Model") or gen:IsA("BasePart") then
                    local part = gen:IsA("BasePart") and gen or gen:FindFirstChildWhichIsA("BasePart")
                    local stats = gen:FindFirstChild("Stats")
                    local completed = stats and stats:FindFirstChild("Completed")
                    local isCompleted = completed and completed:IsA("BoolValue") and completed.Value
                    
                    if part and part.Parent and not isCompleted then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position + Vector3.new(0, part.Size.Y/2 + 1.5, 0))
                        local dist = (Camera.CFrame.Position - part.Position).Magnitude
                        local genColor = GetGeneratorColor(gen)
                        
                        if not Highlights.Generators[gen] then 
                            Highlights.Generators[gen] = CreateHighlight(gen, genColor)
                        else 
                            Highlights.Generators[gen].FillColor = genColor
                            Highlights.Generators[gen].OutlineColor = genColor 
                        end
                        
                        if not Drawings.Generators[gen] then Drawings.Generators[gen] = CreateText() end
                        local draw = Drawings.Generators[gen]
                        
                        if onScreen and dist < 1000 then
                            local genText = "Generator"
                            if gen:FindFirstChild("BrushaDebuffChamber", true) then genText = genText .. "\nBrusha debuff" end
                            local connie = stats and stats:FindFirstChild("Connie")
                            if connie and connie:IsA("BoolValue") and connie.Value then genText = genText .. "\nDeBuff Connie" end
                            
                            local curr = stats and stats:FindFirstChild("CurrentAmount")
                            local req = stats and stats:FindFirstChild("RequiredAmount")
                            if curr and req then genText = genText .. "\n" .. tostring(math.floor(curr.Value)) .. "/" .. tostring(math.floor(req.Value)) end
                            
                            draw.Text = genText
                            draw.Size = math.clamp(1000 / dist, 12, 18)
                            draw.Position = Vector2.new(pos.X, pos.Y)
                            draw.Color = genColor
                            draw.Visible = true
                        else 
                            draw.Visible = false 
                        end
                    else
                        if Highlights.Generators[gen] then Highlights.Generators[gen]:Destroy(); Highlights.Generators[gen] = nil end
                        if Drawings.Generators[gen] then Drawings.Generators[gen]:Remove(); Drawings.Generators[gen] = nil end
                    end
                end
            end
            for obj, hl in pairs(Highlights.Generators) do if not obj.Parent then hl:Destroy(); Highlights.Generators[obj] = nil end end
            for obj, draw in pairs(Drawings.Generators) do if not obj.Parent then draw:Remove(); Drawings.Generators[obj] = nil end end
        end
    end
end)

